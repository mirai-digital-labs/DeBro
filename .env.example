# ==============================================================================
# ENVIRONMENT VARIABLES: Universal Commerce Platform (NexStore)
# ==============================================================================

# Application Environments
NODE_ENV=development

# ------------------------------------------------------------------------------
# Core Infrastructure (PostgreSQL + pgvector & Redis)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=universal_commerce_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/universal_commerce_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Medusa Backend Commerce Engine (apps/backend)
# ------------------------------------------------------------------------------
BACKEND_PORT=9000
BACKEND_URL=http://localhost:9000
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_dev
COOKIE_SECRET=super_secret_cookie_key_min_32_characters_for_dev

# CORS Settings
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:3000

# ------------------------------------------------------------------------------
# Next.js Storefront (apps/storefront)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_STORE_NAME="NexStore PK"
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
NEXT_PUBLIC_DEFAULT_COUNTRY=PK

# ------------------------------------------------------------------------------
# Pakistan Payment Adapters (Sandbox Credentials)
# ------------------------------------------------------------------------------
# JazzCash Sandbox
JAZZCASH_MERCHANT_ID=sandbox_merchant_id
JAZZCASH_PASSWORD=sandbox_password
JAZZCASH_INTEGRITY_SALT=sandbox_salt
JAZZCASH_RETURN_URL=http://localhost:9000/hooks/payment/jazzcash

# Easypaisa Sandbox
EASYPAISA_STORE_ID=sandbox_store_id
EASYPAISA_HASH_KEY=sandbox_hash_key
EASYPAISA_RETURN_URL=http://localhost:9000/hooks/payment/easypaisa

# Cash on Delivery Configuration
COD_MAX_LIMIT_PKR=50000
COD_OTP_VERIFICATION_THRESHOLD=10000

# ------------------------------------------------------------------------------
# International Payment (Stripe - Phase 5 / Phase 8)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# AI Engine & Vector Pipeline (Gemini / OpenAI - Phase 9)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=placeholder_gemini_api_key
OPENAI_API_KEY=placeholder_openai_api_key
